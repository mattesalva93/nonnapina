{
  "name": "nonnapina-prod",
  "version": "1.0.0",
  "description": "Amazon affiliate deal discovery and publishing service",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "server": "tsx src/server.ts",
    "server:dev": "tsx --watch src/server.ts",
    "build": "npx prisma generate && tsc",
    "clean": "rm -rf dist/"
  },
  "keywords": [
    "amazon",
    "affiliate",
    "deals"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prisma": "^7.4.2",
    "puppeteer-real-browser": "^1.4.4",
    "sharp": "^0.34.5",
    "whatsapp-web.js": "^1.34.6",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "hono": "4.12.6",
    "@hono/node-server": "1.19.11",
    "lodash": "4.17.23"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "@vitest/coverage-v8": "^4.0.18",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
