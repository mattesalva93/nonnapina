{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "🚀 Run Nonna Pina",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/index.js",
      "console": "integratedTerminal",
      "runtimeExecutable": "${workspaceFolder}/bin/run-node.sh",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🧪 Test Scraper Only",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/scrapers/keepa.js",
      "console": "integratedTerminal",
      "runtimeExecutable": "${workspaceFolder}/bin/run-node.sh"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🔗 Test Amazon API Only",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/services/amazon.js",
      "console": "integratedTerminal",
      "runtimeExecutable": "${workspaceFolder}/bin/run-node.sh"
    }
  ]
}
