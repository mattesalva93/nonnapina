# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=

# API authentication (Bearer token). If empty, all requests are allowed.
API_SECRET=

# Scheduled scraping (cron syntax — default: 00:15, 06:15 e 18:15 ogni giorno)
SCRAPE_CRON=15 0,6,18 * * *

# ── PostgreSQL (Docker Compose) ─────────────────────────────────────────────
POSTGRES_PASSWORD=
DATABASE_URL=

# ── Amazon Creators API ──────────────────────────────────────────────────────
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=
# Optional: ID dello storefront Amazon per link diretti alla vetrina affiliato
AMAZON_STOREFRONT_ID=

# ── Keepa Scraper ────────────────────────────────────────────────────────────
KEEPA_CATEGORIES=1,5,7,8,10,13,15,22
MAX_PRODUCTS_PER_CATEGORY=10
SCRAPING_DELAY_MS=2000

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── WhatsApp (opzionale) ──────────────────────────────────────────────────────
WHATSAPP_CHANNEL_ID=
WHATSAPP_SESSION_PATH=./.wwebjs_auth

# ── Email Alert (opzionale) ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_CC=
