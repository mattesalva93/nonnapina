{
  "name": "keepa-tracker",
  "version": "0.0.4",
  "description": "Keepa deals scraper with Amazon affiliate link generator",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx --watch src/index.ts",
    "fetch-products": "tsx src/fetch-products.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "clean": "rm -rf output/* dist/"
  },
  "keywords": [
    "keepa",
    "amazon",
    "affiliate",
    "scraper"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "puppeteer-real-browser": "^1.4.4",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
