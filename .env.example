# Server
PORT=3000
NODE_ENV=development

# Scheduled scraping (cron syntax, default: 08:15 and 20:15 daily)
SCRAPE_CRON=15 8,20 * * *

# Scheduled publishing (cron syntax, default: every 30 minutes)
PUBLISH_CRON=*/30 * * * *

# Database (PostgreSQL)
DATABASE_URL=postgresql://npadmin:change_me@localhost:5432/nonnapina
POSTGRES_PASSWORD=change_me

# Amazon Creators API Credentials
AMAZON_ACCESS_KEY=your_client_id_here
AMAZON_SECRET_KEY=your_client_secret_here
AMAZON_PARTNER_TAG=your_partner_tag_here
AMAZON_MARKETPLACE=IT

# Optional: Amazon Storefront ID for storefront redirect links
# Get this from: https://www.amazon.it/your-store (look for storefront_id in URL)
AMAZON_STOREFRONT_ID=

# Keepa Scraper Configuration
KEEPA_CATEGORIES=5,16,3,2
MAX_PRODUCTS_PER_CATEGORY=10
SCRAPING_DELAY_MS=2000
# Telegram Bot (create via @BotFather, add bot as admin to your group)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Output File Paths
OUTPUT_FILE=./output/deals.json
PRODUCTS_OUTPUT_FILE=./output/products-complete.json

# Link Generation Options
# Generate storefront links (requires AMAZON_STOREFRONT_ID)
INCLUDE_STOREFRONT_LINKS=false

# Notes Generation
# Date for generating posts (format: DD/MM/YYYY, leave empty for today's date)
DATE_FOR_POSTS=

# Top Review Scores Category
# Number of top products to feature based on review scores
TOP_REVIEW_COUNT=5
# Minimum number of reviews required for a product to be eligible
MIN_REVIEWS=10

# Top 5 Deals Category
# Number of best deals (by discount percentage) to feature with image collage
TOP_DEALS_COUNT=5
