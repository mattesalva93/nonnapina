# Amazon Creators API Credentials
AMAZON_ACCESS_KEY=your_client_id_here
AMAZON_SECRET_KEY=your_client_secret_here
AMAZON_PARTNER_TAG=your_partner_tag_here
AMAZON_MARKETPLACE=IT

# Optional: Amazon Storefront ID for storefront redirect links
# Get this from: https://www.amazon.it/your-store (look for storefront_id in URL)
AMAZON_STOREFRONT_ID=

# Keepa Scraper Configuration
KEEPA_CATEGORIES=5,16,3,2
MAX_PRODUCTS_PER_CATEGORY=10
SCRAPING_DELAY_MS=2000

# Output File Paths
OUTPUT_FILE=./output/deals.json
PRODUCTS_OUTPUT_FILE=./output/products-complete.json

# Link Generation Options
# Generate deep links for Amazon mobile app (iOS/Android)
INCLUDE_DEEP_LINKS=true
# Generate storefront links (requires AMAZON_STOREFRONT_ID)
INCLUDE_STOREFRONT_LINKS=false

# Notes Generation
# Date for generating posts (format: DD/MM/YYYY, leave empty for today's date)
DATE_FOR_POSTS=
